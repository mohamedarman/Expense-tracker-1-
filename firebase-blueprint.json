        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "recurringId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "amount",
        "kind",
        "categoryId",
        "categoryName",
        "description",
        "merchant",
        "date",
        "paymentMethod",
        "account",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "Budget": {
