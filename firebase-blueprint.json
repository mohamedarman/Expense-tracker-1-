        },
        "categoryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
