{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student profile and allowance configuration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display name of the student."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified email address of the student."
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "description": "Active currency symbol."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "UI theme preference."
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Baseline monthly allowance target."
        },
        "semesterBudget": {
          "type": "number",
          "description": "Baseline semester allowance target."
        },
        "semesterEndDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "ISO date string for semester end."
        },
        "collegeName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Name of college or university."
        },
        "degreeSemester": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Current degree and semester label."
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Account lifecycle status controlled by platform admins."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "currency",
        "theme",
        "monthlyBudget",
        "semesterBudget",
        "semesterEndDate",
        "collegeName",
        "degreeSemester",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server/owner-controlled registry of authorized platform administrators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the administrator."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254,
          "description": "Email address of the administrator."
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owner/admin who granted access."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "owner"],
          "description": "Administrative privilege level."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "uid",
        "email",
        "grantedBy",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "User-owned custom transaction category.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "kind": {
          "type": "string",
          "enum": ["expense", "income"]
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "isEssential": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "name",
        "kind",
        "color",
        "icon",
        "isEssential",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "User-owned income or expense ledger entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
