  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents indexed by Firebase Auth UID."
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Protected administrator registry indexed by Firebase Auth UID."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "User-owned custom spending and income categories."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User-owned financial transactions."
    },
    "/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "User-owned category budget limits."
    },
    "/savingsGoals/{goalId}": {
      "schema": "SavingsGoal",
      "description": "User-owned savings targets."
    },
    "/recurringPayments/{recurringId}": {
      "schema": "RecurringPayment",
      "description": "User-owned recurring commitments and subscriptions."
    },
    "/splitExpenses/{splitId}": {
      "schema": "SplitExpense",
      "description": "User-owned shared peer expense splits."
    },
    "/debts/{debtId}": {
      "schema": "DebtRecord",
      "description": "User-owned peer debt and IOU records."
    }
  }
}
