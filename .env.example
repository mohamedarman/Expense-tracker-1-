# GEMINI_API_KEY: Optional key for Gemini AI API calls (fallback deterministic calculation engine included).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for self-referential links
APP_URL="http://localhost:3000"

# Application Server Configuration
PORT=3000
NODE_ENV="development"
SECRET_KEY="replace-with-a-strong-random-secret-key"

# Python/Flask Backend Database URL (Optional - defaults to SQLite automatically if omitted)
DATABASE_URL="sqlite:///expense_work/student_expense.db"

