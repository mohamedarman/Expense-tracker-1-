# CostCurve — Environment Configuration Example
# Copy this file to .env and provide your own values for local or custom deployments.
# NEVER commit real secrets or private keys to version control.

# Firebase Web App Configuration (Optional override if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Verified Owner / Primary Admin Email
VITE_OWNER_ADMIN_EMAIL=mohamedarman536@gmail.com

# Optional Gemini API Key (Server-side only for optional AI enrichment)
GEMINI_API_KEY=your_gemini_api_key_here
